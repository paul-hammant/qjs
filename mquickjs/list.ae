struct list_head { next: ptr, prev: ptr }
exports (list_head, list_init, list_add, list_del, list_is_empty)
list_init(el: ptr) { var h = el as *list_head; h.next = el; h.prev = el; }
list_add(el: ptr, head: ptr) {
    var h = head as *list_head; var e = el as *list_head;
    var next = h.next; var next_h = next as *list_head;
    e.next = next; e.prev = head; next_h.prev = el; h.next = el;
}
list_del(el: ptr) {
    var e = el as *list_head; var prev = e.prev; var next = e.next;
    var prev_h = prev as *list_head; var next_h = next as *list_head;
    prev_h.next = next; next_h.prev = prev; e.next = null; e.prev = null;
}
list_is_empty(el: ptr) -> int { var h = el as *list_head; if (h.next == el) { return 1; } return 0; }
